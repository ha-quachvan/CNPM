{
  "name": "smart-emobility-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Smart E-Mobility Hub — CO3001 Submission 3",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "npm run build && node tests/browser.mjs",
    "format": "prettier --write src public tests docs README.md package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src public tests docs README.md package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
